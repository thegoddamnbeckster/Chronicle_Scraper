<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>

    <!-- ============================================================================ -->
    <!-- Connection -->
    <!-- ============================================================================ -->
    <category label="32001">
        <!-- Read-only display, not an input field — typing a URL here doesn't
             reliably work (Kodi's on-screen-keyboard edit to a Settings text
             field doesn't always land in the saved value, confirmed live
             2026-08-27). "Edit Connection" below is the one real entry point:
             it prompts for the URL itself via a proven-reliable dialog,
             whenever there isn't already one saved. -->
        <setting id="chronicle_url" type="text" label="32002" enable="false" default=""/>
        <setting id="authorization" type="action" label="32061" action="RunScript(script.chronicle.scraper.tv,action=auth)"/>
        <setting id="change_url" type="action" label="32112" action="RunScript(script.chronicle.scraper.tv,action=change_url)"/>
        <setting id="test_connection" type="action" label="32012" action="RunScript(script.chronicle.scraper.tv,action=test_connection)"/>
        <setting id="auth_status" type="text" label="32080" enable="false" default=""/>
        <!-- Set automatically by the QR/PIN flow above — not meant to be typed by hand -->
        <setting id="api_key" type="text" label="32003" visible="false"/>
        <!-- Cached by _refresh_auth_status()'s GET /api/v1/users/me — last-known display
             name for whoever this API key belongs to, used as a fallback for the menu
             heading/auth_status when a fresh lookup can't reach Chronicle. Not user-facing
             on its own (auth_status already shows the formatted "Connected as {name}" text). -->
        <setting id="connected_display_name" type="text" visible="false"/>
    </category>

    <!-- ============================================================================ -->
    <!-- New Content Detection -->
    <!-- ============================================================================ -->
    <category label="32137">
        <setting id="scan_signal_enabled" type="bool" label="32138" default="false" help="32139"/>
        <setting id="scan_signal_interval_minutes" type="slider" label="32140" default="120" range="30,30,1440" option="int" help="32141" enable="eq(-1,true)"/>
    </category>

    <!-- ============================================================================ -->
    <!-- Library Repair -->
    <!-- ============================================================================ -->
    <!-- See lib/library_repair.py's own module docstring for the full design/safety
         reasoning. Four items, deliberately: "What Is This?" shows the full plain-language
         explanation as an actual dialog rather than relying on this settings screen's own
         help= panel; confirmed live (2026-09-13) that whatever renders help= text isn't
         visible at all on at least one real device/skin combination this addon runs on, so
         the explanation cannot depend on it being seen. Preview is entirely read-only (safe
         to run any time, with nothing to confirm), Repair is the real, destructive action
         (its own confirmation happens in default.py after Preview's same detection pass runs
         again fresh), and Undo Last Repair only ever reverses the single most recent Repair
         run, from the backup it made at the time. help= is still set on each; it costs
         nothing and may render on some skins; but "What Is This?" is now the guaranteed
         path to the explanation, not a supplement to it. -->
    <category label="32150">
        <setting id="library_repair_explain" type="action" label="32173"
                 action="RunScript(script.chronicle.scraper.tv,action=library_repair_explain)"/>
        <setting id="library_repair_preview" type="action" label="32151"
                 action="RunScript(script.chronicle.scraper.tv,action=library_repair_preview)" help="32152"/>
        <setting id="library_repair" type="action" label="32153"
                 action="RunScript(script.chronicle.scraper.tv,action=library_repair)" help="32154"/>
        <setting id="library_repair_undo" type="action" label="32155"
                 action="RunScript(script.chronicle.scraper.tv,action=library_repair_undo)" help="32156"/>
        <!-- Set automatically after each Preview/Repair/Undo run; not meant to be typed by hand. -->
        <setting id="library_repair_last_result" type="text" label="32157" enable="false" default=""/>
    </category>

</settings>
