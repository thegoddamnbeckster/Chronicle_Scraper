<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>

    <!-- ============================================================================ -->
    <!-- Connection -->
    <!-- ============================================================================ -->
    <category label="32001">
        <!-- No Connect/QR flow in this addon (that lives in Chronicle Scraper
             (Movies)'s default.py) -- copy the same URL and API key from that
             addon's settings here. Both plain text, unlike the movies addon's
             hidden api_key, since there's no auth flow here to set it for you. -->
        <setting id="chronicle_url" type="text" label="32002" default=""/>
        <setting id="api_key" type="text" label="32003" default=""/>
    </category>

    <!-- ============================================================================ -->
    <!-- Local Files -->
    <!-- ============================================================================ -->
    <category label="32090">
        <setting id="write_nfo" type="bool" label="32091" default="false" help="32092"/>
        <setting id="write_streamdetails" type="bool" label="32105" default="false" help="32106" enable="eq(-1,true)"/>
    </category>

</settings>
