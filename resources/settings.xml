<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>

    <!-- ============================================================================ -->
    <!-- Connection -->
    <!-- ============================================================================ -->
    <category label="32001">
        <!-- No default here on purpose — Chronicle's address is unique per
             install (LAN IP, hostname, or domain, plus port); a plausible-
             looking default risks silently pointing at the wrong thing. -->
        <setting id="chronicle_url" type="text" label="32002" default=""/>
        <setting id="authorization" type="action" label="32061" action="RunScript(script.chronicle.scraper,action=auth)"/>
        <setting id="auth_status" type="text" label="32080" enable="false" default=""/>
        <!-- Set automatically by the QR/PIN flow above — not meant to be typed by hand -->
        <setting id="api_key" type="text" label="32003" visible="false"/>
    </category>

    <!-- ============================================================================ -->
    <!-- Local Files -->
    <!-- ============================================================================ -->
    <category label="32090">
        <setting id="write_nfo" type="bool" label="32091" default="false" help="32092"/>
        <setting id="write_streamdetails" type="bool" label="32105" default="false" help="32106" enable="eq(-1,true)"/>
        <setting id="rebuild_nfos" type="action" label="32093" action="RunScript(script.chronicle.scraper,action=rebuild_nfos)" help="32094"/>
        <setting id="auto_rebuild_on_scan" type="bool" label="32098" default="false" help="32099"/>
    </category>

</settings>
