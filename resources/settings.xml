<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>

    <!-- ============================================================================ -->
    <!-- Connection -->
    <!-- ============================================================================ -->
    <category label="32001">
        <!-- Read-only display, not an input field — typing a URL here doesn't
             reliably work (Kodi's on-screen-keyboard edit to a Settings text
             field doesn't always land in the saved value, confirmed live
             2026-08-27). "Edit Connection" below is the one real entry point:
             it prompts for the URL itself via a proven-reliable dialog,
             whenever there isn't already one saved. -->
        <setting id="chronicle_url" type="text" label="32002" enable="false" default=""/>
        <setting id="authorization" type="action" label="32061" action="RunScript(script.chronicle.scraper.movie,action=auth)"/>
        <setting id="change_url" type="action" label="32112" action="RunScript(script.chronicle.scraper.movie,action=change_url)"/>
        <setting id="test_connection" type="action" label="32012" action="RunScript(script.chronicle.scraper.movie,action=test_connection)"/>
        <setting id="auth_status" type="text" label="32080" enable="false" default=""/>
        <!-- Set automatically by the QR/PIN flow above — not meant to be typed by hand -->
        <setting id="api_key" type="text" label="32003" visible="false"/>
        <!-- Cached by _refresh_auth_status()'s GET /api/v1/users/me — last-known display
             name for whoever this API key belongs to, used as a fallback for the menu
             heading/auth_status when a fresh lookup can't reach Chronicle. Not user-facing
             on its own (auth_status already shows the formatted "Connected as {name}" text). -->
        <setting id="connected_display_name" type="text" visible="false"/>
    </category>

    <!-- ============================================================================ -->
    <!-- Local Files -->
    <!-- ============================================================================ -->
    <category label="32090">
        <setting id="write_nfo" type="bool" label="32091" default="true" help="32092"/>
        <setting id="write_streamdetails" type="bool" label="32105" default="false" help="32106" enable="eq(-1,true)"/>
        <setting id="rebuild_nfos" type="action" label="32093" action="RunScript(script.chronicle.scraper.movie,action=rebuild_nfos)" help="32094"/>
        <setting id="auto_rebuild_on_scan" type="bool" label="32098" default="true" help="32099"/>
        <!-- Set automatically by lib/settings_upgrade.py the first time this addon runs after
             v3.11.0: a settings.xml default="..." only ever applies to a value Kodi has never
             persisted, so this one-time code migration is what actually gets an
             already-installed copy onto the new write_nfo/auto_rebuild_on_scan defaults. Not
             meant to be touched by hand. -->
        <setting id="migrated_write_nfo_default_v3_11_0" type="bool" visible="false" default="false"/>
    </category>

    <!-- ============================================================================ -->
    <!-- Watch History and Ratings -->
    <!-- ============================================================================ -->
    <category label="32125">
        <setting id="sync_watch_ratings_enabled" type="bool" label="32126" default="true" help="32127"/>
        <setting id="sync_on_kodi_start" type="bool" label="32128" default="true" help="32129" enable="eq(-1,true)"/>
        <setting id="sync_interval_minutes" type="slider" label="32130" default="120" range="30,30,1440" option="int" help="32131" enable="eq(-2,true)"/>
        <setting id="sync_watch_ratings_now" type="action" label="32132" action="RunScript(script.chronicle.scraper.movie,action=sync_watch_ratings)" help="32133"/>
    </category>

    <!-- ============================================================================ -->
    <!-- New Content Detection -->
    <!-- ============================================================================ -->
    <category label="32137">
        <setting id="scan_signal_enabled" type="bool" label="32138" default="false" help="32139"/>
        <setting id="scan_signal_interval_minutes" type="slider" label="32140" default="120" range="30,30,1440" option="int" help="32141" enable="eq(-1,true)"/>
    </category>

</settings>
