msgctxt "#32125"
msgid "Watch History and Ratings"
msgstr ""

msgctxt "#32126"
msgid "Automatically sync watch history and ratings"
msgstr ""

msgctxt "#32127"
msgid "Periodically reconciles resume position, fully-watched status, and rating for every movie, TV show, and episode already in this device's own library against Chronicle, in both directions where applicable (Chronicle's rating always wins; resume/watched use whichever side changed most recently). Lightweight and non-destructive -- unlike \"Rebuild local NFOs\", this never touches local NFO files, so every device can run it independently on its own schedule with no risk of racing another device. On by default."
msgstr ""

